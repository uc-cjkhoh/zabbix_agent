{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/update-changelog.py\" ] || python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/update-changelog.py\"",
            "timeout": 10,
            "statusMessage": "Checking for new commits..." }
        ] }
    ]
  }
}
